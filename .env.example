# Copie para .env.local e preencha.

# reCAPTCHA v2 — se ficar vazio, o widget não é montado e o formulário segue
# funcionando sem verificação (útil em dev; em prod, preencha).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# EmailJS — formulário de contato
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_SEND_EMAIL=

# URL canônica usada em metadata, sitemap e manifest
NEXT_PUBLIC_BASE_URL=https://andrebordignon.dev

# Google Search Console
NEXT_PUBLIC_GOOGLE_VERIFICATION=
